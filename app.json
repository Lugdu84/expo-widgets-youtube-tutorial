{
	"expo": {
		"name": "expo-widgets",
		"slug": "expo-widgets",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "expowidgets",
		"userInterfaceStyle": "automatic",
		"ios": {
			"icon": "./assets/expo.icon",
			"bundleIdentifier": "fr.devaidaya.expowidgets"
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"package": "fr.devaidaya.expowidgets"
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#208AEF",
					"android": {
						"image": "./assets/images/splash-icon.png",
						"imageWidth": 76
					}
				}
			],
			[
				"expo-widgets",
				{
					"groupIdentifier": "group.fr.devaidaya.expowidgets",
					"bundleIdentifier": "fr.devaidaya.expowidgets.widgets",
					"enablePushNotifications": true,
					"widgets": [
						{
							"name": "DeliveryWidget",
							"displayName": "Ma Livraison",
							"description": "Confirme et suis ta livraison",
							"supportedFamilies": [
								"systemSmall",
								"systemMedium",
								"systemLarge"
							]
						}
					]
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
